{
  "name": "okmodel",
  "version": "0.2.0-next.17",
  "description": "okmodel is a catalog-first TypeScript ORM, PostgreSQL first.",
  "keywords": [
    "migrations",
    "orm",
    "postgres",
    "postgresql",
    "typescript"
  ],
  "homepage": "https://github.com/omqkhafi/okmodel",
  "bugs": {
    "url": "https://github.com/omqkhafi/okmodel/issues"
  },
  "license": "Apache-2.0",
  "author": "Omq Khafi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omqkhafi/okmodel.git"
  },
  "bin": {
    "okm": "./dist/okm.js",
    "okmodel": "./dist/okmodel.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./pg": {
      "types": "./dist/dialects/pg/index.d.ts",
      "import": "./dist/dialects/pg/index.js"
    },
    "./internal": {
      "types": "./dist/contracts/internal.d.ts",
      "import": "./dist/contracts/internal.js"
    },
    "./migrate": {
      "types": "./dist/tooling/migrate/index.d.ts",
      "import": "./dist/tooling/migrate/index.js"
    },
    "./pg/postgresjs": {
      "types": "./dist/runtime/pg/postgresjs.d.ts",
      "import": "./dist/runtime/pg/postgresjs.js"
    },
    "./pg/pglite": {
      "types": "./dist/runtime/pg/pglite.d.ts",
      "import": "./dist/runtime/pg/pglite.js"
    },
    "./pg/pg": {
      "types": "./dist/runtime/pg/pg.d.ts",
      "import": "./dist/runtime/pg/pg.js"
    },
    "./pg/bun": {
      "types": "./dist/runtime/pg/bun.d.ts",
      "import": "./dist/runtime/pg/bun.js"
    },
    "./ids": {
      "types": "./dist/runtime/ids/index.d.ts",
      "import": "./dist/runtime/ids/index.js"
    },
    "./safety": {
      "types": "./dist/runtime/safety/index.d.ts",
      "import": "./dist/runtime/safety/index.js"
    },
    "./traits": {
      "types": "./dist/runtime/traits/index.d.ts",
      "import": "./dist/runtime/traits/index.js"
    },
    "./tenancy": {
      "types": "./dist/runtime/tenancy/index.d.ts",
      "import": "./dist/runtime/tenancy/index.js"
    },
    "./validate": {
      "types": "./dist/runtime/validate/index.d.ts",
      "import": "./dist/runtime/validate/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/contracts/index.ts ./src/contracts/internal.ts ./src/dialects/pg/index.ts ./src/runtime/pg/postgresjs.ts ./src/runtime/pg/pglite.ts ./src/runtime/pg/pg.ts ./src/runtime/pg/bun.ts ./src/runtime/ids/index.ts ./src/runtime/safety/index.ts ./src/runtime/traits/index.ts ./src/runtime/tenancy/index.ts ./src/runtime/validate/index.ts ./src/tooling/migrate/index.ts ./src/tooling/cli.ts --outdir ./dist --root ./src --format esm --target node --splitting --chunk-naming=shared/[hash].js --external postgres --external @electric-sql/pglite --external pg --external bun && bunx tsc -p tsconfig.build.json && bun ./scripts/write-bin-wrappers.ts",
    "driver-bench": "bun ./scripts/driver-bench.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "editor-check": "bun ./scripts/editor-check.ts",
    "type-cost": "bun ./scripts/type-cost.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "layers-check": "bun ./scripts/layers-check.ts",
    "core-purity": "bun ./scripts/core-purity.ts",
    "okid-drift": "bun ./scripts/okid-drift.ts",
    "test:runtimes": "bun ./scripts/runtimes.ts",
    "docs:check": "bun ./scripts/docs-check.ts",
    "readme:check": "bun ./scripts/readme-check.ts",
    "compiler-api": "bun ./scripts/compiler-api.ts",
    "publint": "publint run . --strict --pack bun",
    "attw": "bun ./scripts/attw.ts",
    "size": "bun ./scripts/size.ts",
    "bundle-purity": "bun ./scripts/bundle-purity.ts",
    "test": "bun test",
    "test:postgres": "bun ./scripts/postgres-suite.ts",
    "test:tarball": "bun ./scripts/tarball-smoke.ts",
    "verify": "bun ./scripts/verify.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run editor-check && bun run type-cost && bun run layers-check && bun run core-purity && bun run okid-drift && bun run docs:check && bun run readme:check && bun run compiler-api && bun run bundle-purity && bun run build && bun test && bun run test:runtimes && bun run publint && bun run attw && bun run size",
    "bump": "bun ./scripts/bump-version.ts",
    "release-check": "bun ./scripts/release-check.ts",
    "db:up": "bun ./packages/harness/src/docker-cli.ts up",
    "db:down": "bun ./packages/harness/src/docker-cli.ts down",
    "bench": "bun ./packages/bench/src/run.ts",
    "catalog-bench": "bun ./scripts/catalog-bench.ts",
    "attest": "ATTEST_shouldFormat=0 ATTEST_updateSnapshots=0 bun ./packages/attest/src/measure.bench.ts",
    "publish:dry": "bun publish --dry-run",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bun": "^1.4.2",
    "expect-type": "^1.4.0",
    "fast-check": "^4.10.2",
    "oxc-parser": "^0.152.0",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "typescript": "7",
    "typescript-editor": "npm:typescript@6.0.3"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.16.0",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
