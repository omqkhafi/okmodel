{
  "name": "okmodel",
  "version": "0.10.0-next.52",
  "description": "okmodel is a catalog-first TypeScript ORM, PostgreSQL first.",
  "keywords": [
    "migrations",
    "orm",
    "postgres",
    "postgresql",
    "typescript"
  ],
  "homepage": "https://github.com/omqkhafi/okmodel",
  "bugs": {
    "url": "https://github.com/omqkhafi/okmodel/issues"
  },
  "license": "Apache-2.0",
  "author": "Omq Khafi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omqkhafi/okmodel.git"
  },
  "bin": {
    "okm": "./dist/okm.js",
    "okmodel": "./dist/okmodel.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "docs",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./pg": {
      "types": "./dist/dialects/pg/index.d.ts",
      "import": "./dist/dialects/pg/index.js"
    },
    "./internal": {
      "types": "./dist/contracts/internal.d.ts",
      "import": "./dist/contracts/internal.js"
    },
    "./migrate": {
      "types": "./dist/tooling/migrate/index.d.ts",
      "import": "./dist/tooling/migrate/index.js"
    },
    "./pg/postgresjs": {
      "types": "./dist/runtime/pg/postgresjs.d.ts",
      "import": "./dist/runtime/pg/postgresjs.js"
    },
    "./pg/pglite": {
      "types": "./dist/runtime/pg/pglite.d.ts",
      "import": "./dist/runtime/pg/pglite.js"
    },
    "./pg/pg": {
      "types": "./dist/runtime/pg/pg.d.ts",
      "import": "./dist/runtime/pg/pg.js"
    },
    "./pg/bun": {
      "types": "./dist/runtime/pg/bun.d.ts",
      "import": "./dist/runtime/pg/bun.js"
    },
    "./pg/neon": {
      "types": "./dist/runtime/pg/neon.d.ts",
      "import": "./dist/runtime/pg/neon.js"
    },
    "./ids": {
      "types": "./dist/runtime/ids/index.d.ts",
      "import": "./dist/runtime/ids/index.js"
    },
    "./safety": {
      "types": "./dist/runtime/safety/index.d.ts",
      "import": "./dist/runtime/safety/index.js"
    },
    "./traits": {
      "types": "./dist/runtime/traits/index.d.ts",
      "import": "./dist/runtime/traits/index.js"
    },
    "./tenancy": {
      "types": "./dist/runtime/tenancy/index.d.ts",
      "import": "./dist/runtime/tenancy/index.js"
    },
    "./testing": {
      "types": "./dist/tooling/testing/index.d.ts",
      "import": "./dist/tooling/testing/index.js"
    },
    "./validate": {
      "types": "./dist/runtime/validate/index.d.ts",
      "import": "./dist/runtime/validate/index.js"
    },
    "./otel": {
      "types": "./dist/runtime/otel.d.ts",
      "import": "./dist/runtime/otel.js"
    },
    "./observe": {
      "types": "./dist/runtime/observe.d.ts",
      "import": "./dist/runtime/observe.js"
    },
    "./ext": {
      "types": "./dist/dialects/pg/ext/index.d.ts",
      "import": "./dist/dialects/pg/ext/index.js"
    },
    "./fn": {
      "types": "./dist/dialects/pg/fn/index.d.ts",
      "import": "./dist/dialects/pg/fn/index.js"
    },
    "./view": {
      "types": "./dist/dialects/pg/view/index.d.ts",
      "import": "./dist/dialects/pg/view/index.js"
    },
    "./pg/citext": {
      "types": "./dist/dialects/pg/ext/citext.d.ts",
      "import": "./dist/dialects/pg/ext/citext.js"
    },
    "./pg/pg_trgm": {
      "types": "./dist/dialects/pg/ext/pg-trgm.d.ts",
      "import": "./dist/dialects/pg/ext/pg-trgm.js"
    },
    "./pg/unaccent": {
      "types": "./dist/dialects/pg/ext/unaccent.d.ts",
      "import": "./dist/dialects/pg/ext/unaccent.js"
    },
    "./pg/hstore": {
      "types": "./dist/dialects/pg/ext/hstore.d.ts",
      "import": "./dist/dialects/pg/ext/hstore.js"
    },
    "./pg/ltree": {
      "types": "./dist/dialects/pg/ext/ltree.d.ts",
      "import": "./dist/dialects/pg/ext/ltree.js"
    },
    "./pg/btree_gist": {
      "types": "./dist/dialects/pg/ext/btree-gist.d.ts",
      "import": "./dist/dialects/pg/ext/btree-gist.js"
    },
    "./pg/btree_gin": {
      "types": "./dist/dialects/pg/ext/btree-gin.d.ts",
      "import": "./dist/dialects/pg/ext/btree-gin.js"
    },
    "./pg/fuzzystrmatch": {
      "types": "./dist/dialects/pg/ext/fuzzystrmatch.d.ts",
      "import": "./dist/dialects/pg/ext/fuzzystrmatch.js"
    },
    "./pg/pgcrypto": {
      "types": "./dist/dialects/pg/ext/pgcrypto.d.ts",
      "import": "./dist/dialects/pg/ext/pgcrypto.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/contracts/index.ts ./src/contracts/internal.ts ./src/dialects/pg/index.ts ./src/runtime/pg/postgresjs.ts ./src/runtime/pg/pglite.ts ./src/runtime/pg/pg.ts ./src/runtime/pg/bun.ts ./src/runtime/pg/neon.ts ./src/runtime/ids/index.ts ./src/runtime/safety/index.ts ./src/runtime/traits/index.ts ./src/runtime/tenancy/index.ts ./src/runtime/validate/index.ts ./src/runtime/otel.ts ./src/runtime/observe.ts ./src/dialects/pg/ext/index.ts ./src/dialects/pg/fn/index.ts ./src/dialects/pg/view/index.ts ./src/dialects/pg/ext/citext.ts ./src/dialects/pg/ext/pg-trgm.ts ./src/dialects/pg/ext/unaccent.ts ./src/dialects/pg/ext/hstore.ts ./src/dialects/pg/ext/ltree.ts ./src/dialects/pg/ext/btree-gist.ts ./src/dialects/pg/ext/btree-gin.ts ./src/dialects/pg/ext/fuzzystrmatch.ts ./src/dialects/pg/ext/pgcrypto.ts ./src/tooling/migrate/index.ts ./src/tooling/testing/index.ts ./src/tooling/cli.ts --outdir ./dist --root ./src --format esm --target node --splitting --chunk-naming=shared/[hash].js --external postgres --external @electric-sql/pglite --external pg --external bun --external @neondatabase/serverless && bunx tsc -p tsconfig.build.json && rm -f ./dist/dialects/pg/temporal.local.d.ts && bun build ./packages/harness/src/driver-run.ts --outdir ./dist/tooling --format esm --target node --splitting --chunk-naming=shared/[hash].js --external postgres --external @electric-sql/pglite --external pg --external bun --external @neondatabase/serverless && bun ./scripts/write-bin-wrappers.ts",
    "driver-bench": "bun ./scripts/driver-bench.ts",
    "typecheck": "mkdir -p .cache/tsc && bun ./scripts/ts-range.ts && bunx tsc --noEmit -p tests/fixtures/raw/tsconfig.json --incremental --tsBuildInfoFile .cache/tsc/raw.tsbuildinfo",
    "editor-check": "bun ./scripts/editor-check.ts",
    "type-cost": "bun ./scripts/type-cost.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "layers-check": "bun ./scripts/layers-check.ts",
    "core-purity": "bun ./scripts/core-purity.ts",
    "okid-drift": "bun ./scripts/okid-drift.ts",
    "test:runtimes": "bun ./scripts/runtimes.ts",
    "docs:errors": "bun ./scripts/docs-errors.ts",
    "docs:index": "bun ./scripts/docs-index.ts",
    "docs:hygiene": "bun ./scripts/docs-hygiene.ts",
    "docs:check": "bun ./scripts/docs-check.ts",
    "readme:check": "bun ./scripts/readme-check.ts",
    "compiler-api": "bun ./scripts/compiler-api.ts",
    "publint": "publint run . --strict --pack bun",
    "attw": "bun ./scripts/attw.ts",
    "pack-tracked": "bun ./scripts/pack-tracked.ts",
    "pack-contract": "bun ./scripts/pack-contract.ts",
    "pack-size": "bun ./scripts/pack-size.ts",
    "ts6:check": "bun ./scripts/ts-range.ts --editor",
    "prepack": "bun ./scripts/strip-workspaces.ts strip && bun ./scripts/docs-pack.ts stamp",
    "postpack": "bun ./scripts/docs-pack.ts restore && bun ./scripts/strip-workspaces.ts restore",
    "size": "bun ./scripts/size.ts",
    "bundle-purity": "bun ./scripts/bundle-purity.ts",
    "test": "bun test",
    "test:postgres": "bun ./scripts/postgres-suite.ts",
    "test:tarball": "bun ./scripts/tarball-smoke.ts",
    "verify": "bun ./scripts/verify.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run editor-check && bun run type-cost && bun run layers-check && bun run core-purity && bun run okid-drift && bun run docs:check && bun run readme:check && bun run compiler-api && bun run bundle-purity && bun run build && bun test && bun run test:runtimes && bun run publint && bun run attw && bun run pack-tracked && bun run pack-contract && bun run size",
    "ci:report": "bun ./scripts/ci-report.ts",
    "ci:fail": "bun ./scripts/ci-fail.ts",
    "verify:fast": "bun ./scripts/verify-fast.ts",
    "bump": "bun ./scripts/bump-version.ts",
    "release-check": "bun ./scripts/release-check.ts",
    "db:up": "bun ./packages/harness/src/docker-cli.ts up",
    "db:down": "bun ./packages/harness/src/docker-cli.ts down",
    "bench": "bun ./packages/bench/src/run.ts",
    "catalog-bench": "bun ./scripts/catalog-bench.ts",
    "attest": "ATTEST_shouldFormat=0 ATTEST_updateSnapshots=0 bun ./packages/attest/src/measure.bench.ts",
    "dev": "bun run site:dev",
    "site:dev": "bun --cwd site dev",
    "site:build": "bun --cwd site build",
    "site:check": "bun --cwd site check",
    "publish:dry": "bun publish --dry-run",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bun": "^1.4.3",
    "drizzle-orm": "0.45.4",
    "expect-type": "^1.4.0",
    "fast-check": "^4.10.2",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "temporal-polyfill": "^1.0.6",
    "temporal-spec": "^1.0.1",
    "typescript": "7",
    "typescript-editor": "npm:typescript@6.0.3"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "pg": "^8.16.0",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.18"
  }
}
