{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/generate.json",
  "title": "okm generate data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag",
        "target",
        "emptyRows",
        "suggest"
      ],
      "properties": {
        "flag": {
          "const": "--fill"
        },
        "target": {
          "type": "string"
        },
        "emptyRows": {
          "type": [
            "number",
            "string"
          ]
        },
        "suggest": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
