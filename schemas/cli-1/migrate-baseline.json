{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/migrate-baseline.json",
  "title": "okm migrate baseline data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "migrationId",
    "catalogHash",
    "status",
    "unmanaged"
  ],
  "properties": {
    "target": {
      "type": "string"
    },
    "migrationId": {
      "type": "string"
    },
    "catalogHash": {
      "type": "string"
    },
    "status": {
      "enum": [
        "baselined",
        "already-baselined",
        "dry-run"
      ]
    },
    "unmanaged": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "untrusted",
              "origin",
              "text",
              "truncated",
              "modified"
            ],
            "properties": {
              "untrusted": {
                "const": true
              },
              "origin": {
                "enum": [
                  "schema.identifier",
                  "schema.comment",
                  "schema.enum",
                  "schema.default",
                  "constraint.name",
                  "index.name",
                  "migration.comment",
                  "db.error",
                  "db.object-name",
                  "user.query"
                ]
              },
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "modified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
