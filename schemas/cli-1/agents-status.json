{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/agents-status.json",
  "title": "okm agents status data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "files"
  ],
  "properties": {
    "status": {
      "enum": [
        "current",
        "drifted",
        "declined"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "block",
              "import",
              "skill",
              "record"
            ]
          },
          "state": {
            "enum": [
              "current",
              "stale",
              "missing",
              "modified"
            ]
          }
        }
      }
    }
  }
}
