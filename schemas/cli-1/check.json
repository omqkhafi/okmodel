{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/check.json",
  "title": "okm check data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "notice": {
      "type": "string"
    },
    "emulation": {
      "type": "string"
    },
    "ignores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "reason"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "reason": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "untrusted",
              "origin",
              "text",
              "truncated",
              "modified"
            ],
            "properties": {
              "untrusted": {
                "const": true
              },
              "origin": {
                "enum": [
                  "schema.identifier",
                  "schema.comment",
                  "schema.enum",
                  "schema.default",
                  "constraint.name",
                  "index.name",
                  "migration.comment",
                  "db.error",
                  "db.object-name",
                  "user.query",
                  "package.json"
                ]
              },
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "modified": {
                "type": "boolean"
              }
            }
          },
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "applied",
              "stale"
            ]
          }
        }
      }
    }
  }
}
