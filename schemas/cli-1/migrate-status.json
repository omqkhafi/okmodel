{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/migrate-status.json",
  "title": "okm migrate status data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "steps"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "state",
          "attempt",
          "nextAction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "attempt": {
            "type": "number"
          },
          "nextAction": {
            "type": "string"
          }
        }
      }
    }
  }
}
