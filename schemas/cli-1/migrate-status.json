                  "migration.comment",
                  "db.error",
                  "db.object-name",
                  "user.query"
                ]
              },
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "modified": {
                "type": "boolean"
              }
            }
          },
          "kind": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "untrusted",
              "origin",
              "text",
              "truncated",
              "modified"
            ],
            "properties": {
              "untrusted": {
                "const": true
              },
              "origin": {
                "enum": [
                  "schema.identifier",
                  "schema.comment",
                  "schema.enum",
                  "schema.default",
                  "constraint.name",
                  "index.name",
                  "migration.comment",
