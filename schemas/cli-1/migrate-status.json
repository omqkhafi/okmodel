              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "modified": {
                "type": "boolean"
              }
            }
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "untrusted",
