{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/migrate-check.json",
  "title": "okm migrate check data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "allows": {
      "type": "array",
      "description": "Every `-- okm-allow` line in the migrations directory.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "migration",
          "step",
          "code",
          "ruleClass",
          "destructive",
          "reason"
        ],
        "properties": {
          "migration": {
            "type": "string"
          },
          "step": {
            "type": "number"
          },
          "code": {
            "type": "string"
          },
          "ruleClass": {
            "enum": [
              "destructive",
              "backward-incompatible",
              "data-dependent",
              "locking",
              "type-preference",
              "reprint",
              "unknown"
            ]
          },
          "destructive": {
            "type": "boolean"
          },
          "reason": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "untrusted",
              "origin",
              "text",
              "truncated",
              "modified"
            ],
            "properties": {
              "untrusted": {
                "const": true
              },
              "origin": {
                "enum": [
                  "schema.identifier",
                  "schema.comment",
                  "schema.enum",
                  "schema.default",
                  "constraint.name",
                  "index.name",
                  "migration.comment",
                  "db.error",
                  "db.object-name",
                  "user.query",
                  "package.json"
                ]
              },
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "modified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
