{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okmodel.dev/schemas/cli-1/doctor.json",
  "title": "okm doctor data",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "summary",
        "fix"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "safeAlternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "docs"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "docs": {
                "type": "string"
              }
            }
          }
        },
        "docs": {
          "type": "string"
        },
        "escapeHatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "requiresHumanReason",
              "docs"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "requiresHumanReason": {
                "const": true
              },
              "docs": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    }
  ]
}
