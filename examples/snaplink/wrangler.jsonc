{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snaplink",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "NEON_MODE": "websocket"
  },
  "secrets": {
    "required": ["DATABASE_URL"]
  }
}
