{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "docs",
    ".agents",
    ".cursor",
    "tests/fixtures",
    "packages/attest",
    "site",
    "*.tgz",
    "src/runtime/ids/okid.ts",
    "src/runtime/ids/okid-shared.ts",
    "src/runtime/ids/okid-extended.ts"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  }
}
