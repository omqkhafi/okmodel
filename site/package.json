{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "bun ./scripts/sync-docs.ts",
    "dev": "bun run sync && next dev --port 3333",
    "build": "bun run sync && fumadocs-mdx && next build",
    "start": "next start",
    "types": "bun run sync && fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "bun run sync && fumadocs-mdx && bun test ./lib/*.site-test.ts ./scripts/*.site-test.ts",
    "check": "bun run sync && fumadocs-mdx && next typegen && tsc --noEmit && bun test ./lib/*.site-test.ts ./scripts/*.site-test.ts",
    "postinstall": "bun run sync && fumadocs-mdx"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fumadocs/base-ui": "16.15.13",
    "cnfast": "^0.2.0",
    "framer-motion": "^13.4.2",
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "mdast-util-to-markdown": "2.1.2"
  }
}
